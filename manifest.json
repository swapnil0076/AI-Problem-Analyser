{
  "manifest_version": 3,
  "name": "LeetCode AI Analyzer",
  "version": "1.0.0",
  "description": "AI-powered code analysis for LeetCode. Get instant feedback on your approach, time & space complexity, and actionable improvement suggestions.",

  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel",
    "windows"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "https://integrate.api.nvidia.com/*"
  ],

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LeetCode AI Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["src/content/bridge.js"],
      "matches": ["https://leetcode.com/*"]
    },
    {
      "resources": ["data/*", "data/by-tag/*", "data/by-difficulty/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["dryrun/*", "src/utils/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
